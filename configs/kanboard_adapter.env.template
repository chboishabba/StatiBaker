# StatiBaker -> Kanboard adapter local template (non-secret placeholders only)
# Copy into a local private env file outside version control before real use.

KANBOARD_BASE_URL=http://127.0.0.1/kanboard
KANBOARD_JSONRPC_ENDPOINT=http://127.0.0.1/kanboard/jsonrpc.php
KANBOARD_PROJECT_ID=1

# Kanboard API user and token for JSON-RPC auth (placeholder values only).
KANBOARD_API_USER=api-user
KANBOARD_API_TOKEN=replace-with-token

# Optional header-based API auth if enabled in Kanboard config.
# Keep empty when using basic user/token auth.
KANBOARD_API_AUTH_HEADER=
